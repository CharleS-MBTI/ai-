# ==========================================
# AI智能日历 - 后端环境变量配置
# ==========================================
# 复制此文件为 .env 并填入真实值：
# cp .env.example .env
# ==========================================

# ---------- 基础配置 ----------

# 服务端口号（可选，默认3001）
PORT=3001

# 运行环境：development | production（可选，默认development）
# production 模式下会启用微信真实登录而非模拟登录
NODE_ENV=development

# ---------- 安全认证 ----------

# JWT 签名密钥（必填！！！）
# 生产环境请使用随机生成的强密码，至少32位
# 生成方式：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-jwt-secret-change-in-production

# ---------- 微信小程序配置 ----------

# 微信小程序 AppID（必填，生产环境）
# 获取方式：微信公众平台(mp.weixin.qq.com) → 开发管理 → 开发设置
WX_APPID=your-wechat-appid

# 微信小程序 AppSecret（必填，生产环境）
# 获取方式：同上页面，点击"重置"获取（注意：重置后旧密钥作废）
# 安全提醒：AppSecret 不应提交到代码仓库
WX_SECRET=your-wechat-secret

# ---------- AI 服务配置 ----------

# OpenRouter API Key（可选，不填则使用离线模拟建议）
# 获取方式：访问 https://openrouter.ai/keys 注册并创建 API Key
# 支持多种模型：DeepSeek、Claude、GPT 等，具体见 https://openrouter.ai/models
OPENROUTER_API_KEY=your-openrouter-api-key

# AI 模型名称（可选，默认 deepseek/deepseek-chat-v3-0324）
# 推荐模型：
#   deepseek/deepseek-chat-v3-0324  — 性价比高
#   anthropic/claude-3.5-sonnet      — 体验最佳
#   openai/gpt-4o-mini               — 速度快
OPENROUTER_MODEL=deepseek/deepseek-chat-v3-0324

# AI 最大输出 Token 数（可选，默认600）
# 建议范围 300-1000，建议越短响应越快
AI_MAX_TOKENS=600

# AI 输出温度 0-2（可选，默认0.7）
# 值越高回复越有创意，值越低回复越稳定
AI_TEMPERATURE=0.7

# ---------- 数据库配置 ----------

# SQLite 数据库文件路径（可选，默认 ./data/calendar.db）
# 生产环境建议使用绝对路径或保持默认
DB_PATH=./data/calendar.db
