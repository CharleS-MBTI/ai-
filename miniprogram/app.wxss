/* app.wxss — AI智能日历全局样式 */
/* Design: 暖金 x 深邃靛蓝 — 极简奢华AI日历 */

page {
  /* === 色彩体系 === */
  --bg-deep: #0A0D1A;
  --bg-primary: #111527;
  --bg-surface: rgba(255, 255, 255, 0.04);
  --bg-surface-hover: rgba(255, 255, 255, 0.08);
  --bg-surface-raised: rgba(255, 255, 255, 0.06);

  --gold: #C8A96E;
  --gold-light: #D9C28B;
  --gold-dark: #A88D52;
  --gold-glow: rgba(200, 169, 110, 0.12);
  --gold-strong: rgba(200, 169, 110, 0.25);

  --text-primary: #F0ECE4;
  --text-secondary: rgba(240, 236, 228, 0.6);
  --text-muted: rgba(240, 236, 228, 0.35);
  --text-dim: rgba(240, 236, 228, 0.18);

  --border: rgba(240, 236, 228, 0.07);
  --border-active: rgba(200, 169, 110, 0.25);

  --danger: #E05560;
  --danger-bg: rgba(224, 85, 96, 0.12);
  --success: #5DAE8B;
  --success-bg: rgba(93, 174, 139, 0.12);

  /* === 圆角 === */
  --radius-sm: 8rpx;
  --radius: 14rpx;
  --radius-lg: 20rpx;
  --radius-xl: 28rpx;

  /* === 阴影 === */
  --shadow-sm: 0 2rpx 8rpx rgba(0, 0, 0, 0.3);
  --shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.4);
  --shadow-lg: 0 8rpx 40rpx rgba(0, 0, 0, 0.5);
  --glow-gold: 0 0 24rpx rgba(200, 169, 110, 0.08);

  /* === 字体 === */
  font-family: -apple-system, BlinkMacSystemFont, 'SF Pro Display', 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', sans-serif;
  font-size: 28rpx;
  color: var(--text-primary);
  background: linear-gradient(180deg, var(--bg-deep) 0%, var(--bg-primary) 100%);
  background-attachment: fixed;
  box-sizing: border-box;
  -webkit-font-smoothing: antialiased;
}

/* === 全局网格纹理 === */
page::after {
  content: '';
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-image:
    radial-gradient(circle at 30% 10%, rgba(200, 169, 110, 0.03) 0%, transparent 50%),
    radial-gradient(circle at 70% 80%, rgba(200, 169, 110, 0.02) 0%, transparent 40%);
  pointer-events: none;
  z-index: 0;
}

/* === 通用容器 === */
.container {
  padding: 24rpx;
  min-height: 100vh;
  position: relative;
  z-index: 1;
}

/* === 卡片 === */
.card {
  background: var(--bg-surface);
  border: 1rpx solid var(--border);
  border-radius: var(--radius-lg);
  padding: 24rpx;
  margin-bottom: 20rpx;
  backdrop-filter: blur(10rpx);
  -webkit-backdrop-filter: blur(10rpx);
}

/* === 按钮 === */
.btn-primary {
  background: linear-gradient(135deg, var(--gold) 0%, var(--gold-dark) 100%);
  color: var(--bg-deep);
  border-radius: var(--radius);
  padding: 22rpx 40rpx;
  text-align: center;
  font-size: 29rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
}

.btn-primary:active {
  opacity: 0.85;
  transform: scale(0.98);
}

/* === 标签 === */
.tag {
  display: inline-block;
  padding: 6rpx 14rpx;
  border-radius: var(--radius-sm);
  font-size: 22rpx;
  font-weight: 500;
  letter-spacing: 0.5rpx;
}

/* === 空状态 === */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
  color: var(--text-muted);
  text-align: center;
}

.empty-state .icon {
  font-size: 80rpx;
  margin-bottom: 24rpx;
  opacity: 0.5;
}

.empty-title {
  font-size: 30rpx;
  color: var(--text-secondary);
  margin-bottom: 8rpx;
  font-weight: 500;
}

.empty-state .sub-text {
  font-size: 24rpx;
  color: var(--text-dim);
  margin-top: 10rpx;
}

/* === 加载 === */
.loading-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx;
  color: var(--text-muted);
}

/* === 分割线 === */
.divider {
  height: 1rpx;
  background: var(--border);
  margin: 24rpx 0;
}
