<!-- pages/profile/profile.wxml - 个人中心 -->
<view class="container">
  <!-- 用户信息区域 -->
  <view class="profile-header">
    <view class="avatar-section" wx:if="{{isLoggedIn}}">
      <image class="avatar" src="{{userInfo.avatarUrl || '/images/default-avatar.png'}}" mode="aspectFill" />
      <view class="user-info">
        <text class="nickname">{{userInfo.nickname || '微信用户'}}</text>
        <text class="uid">ID: {{userInfo.id}}</text>
      </view>
    </view>
    <button class="login-btn" wx:else open-type="getUserInfo" bindgetuserinfo="onLogin">
      微信一键登录
    </button>
  </view>

  <!-- 数据统计 -->
  <view class="stats-row" wx:if="{{isLoggedIn}}">
    <view class="stat-item">
      <text class="stat-num">{{stats.scheduleCount}}</text>
      <text class="stat-label">日程总数</text>
    </view>
    <view class="stat-divider"></view>
    <view class="stat-item">
      <text class="stat-num">{{stats.suggestionCount}}</text>
      <text class="stat-label">AI建议</text>
    </view>
    <view class="stat-divider"></view>
    <view class="stat-item">
      <text class="stat-num">{{stats.dayCount}}</text>
      <text class="stat-label">使用天数</text>
    </view>
  </view>

  <!-- 功能列表 -->
  <view class="menu-section" wx:if="{{isLoggedIn}}">
    <view class="menu-title">功能</view>
    <view class="menu-list">
      <view class="menu-item" bindtap="goToSuggestion">
        <text class="menu-icon">🤖</text>
        <text class="menu-text">AI建议历史</text>
        <text class="menu-arrow">›</text>
      </view>
      <view class="menu-item" bindtap="exportData">
        <text class="menu-icon">📤</text>
        <text class="menu-text">导出日程数据</text>
        <text class="menu-arrow">›</text>
      </view>
    </view>
  </view>

  <!-- 设置 -->
  <view class="menu-section" wx:if="{{isLoggedIn}}">
    <view class="menu-title">设置</view>
    <view class="menu-list">
      <view class="menu-item" bindtap="clearCache">
        <text class="menu-icon">🗑️</text>
        <text class="menu-text">清除缓存</text>
        <text class="menu-arrow">›</text>
      </view>
      <view class="menu-item">
        <text class="menu-icon">📋</text>
        <text class="menu-text">用户协议</text>
        <text class="menu-arrow">›</text>
      </view>
      <view class="menu-item">
        <text class="menu-icon">🔒</text>
        <text class="menu-text">隐私政策</text>
        <text class="menu-arrow">›</text>
      </view>
    </view>
  </view>

  <!-- 关于 -->
  <view class="about-section" wx:if="{{isLoggedIn}}">
    <view class="menu-title">关于</view>
    <view class="menu-list">
      <view class="menu-item">
        <text class="menu-icon">ℹ️</text>
        <text class="menu-text">版本</text>
        <text class="menu-value">v1.0.0</text>
      </view>
      <view class="menu-item">
        <text class="menu-icon">🤖</text>
        <text class="menu-text">AI引擎</text>
        <text class="menu-value">DeepSeek V3</text>
      </view>
    </view>
  </view>

  <!-- 退出登录 -->
  <view class="logout-section" wx:if="{{isLoggedIn}}">
    <view class="btn-logout" bindtap="logout">退出登录</view>
  </view>
</view>
