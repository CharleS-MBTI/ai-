/* pages/index/index.wxss — 日历首页 */
/* 暖金深色主题 */

/* === 月份导航 === */
.month-header {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 28rpx 0 20rpx;
  gap: 20rpx;
  position: relative;
  z-index: 2;
}

.month-nav {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: var(--bg-surface);
  border: 1rpx solid var(--border);
  transition: all 0.2s;
}

.month-nav:active {
  background: var(--bg-surface-hover);
  border-color: var(--border-active);
}

.arrow {
  font-size: 22rpx;
  color: var(--text-secondary);
}

.month-title {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--text-primary);
  min-width: 200rpx;
  text-align: center;
  letter-spacing: 1rpx;
}

.today-btn {
  font-size: 24rpx;
  color: var(--gold);
  padding: 8rpx 22rpx;
  background: var(--gold-glow);
  border: 1rpx solid var(--border-active);
  border-radius: 24rpx;
  font-weight: 500;
}

.today-btn:active {
  background: var(--gold-strong);
}

/* === 星期头 === */
.week-header {
  display: flex;
  padding: 16rpx 4rpx 12rpx;
}

.week-day {
  flex: 1;
  text-align: center;
  font-size: 23rpx;
  color: var(--text-muted);
  font-weight: 500;
  text-transform: uppercase;
  letter-spacing: 1rpx;
}

/* === 日历网格 === */
.calendar-grid {
  display: flex;
  flex-wrap: wrap;
  background: var(--bg-surface);
  border: 1rpx solid var(--border);
  border-radius: var(--radius-xl);
  padding: 8rpx;
  backdrop-filter: blur(10rpx);
  -webkit-backdrop-filter: blur(10rpx);
}

.day-cell {
  width: calc(100% / 7);
  aspect-ratio: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  position: relative;
  border-radius: var(--radius);
  transition: background 0.15s;
}

.day-num {
  font-size: 28rpx;
  color: var(--text-primary);
  font-weight: 400;
  line-height: 1;
}

.day-cell.other-month .day-num {
  color: var(--text-dim);
}

/* 今日标记：暖金光圈 */
.day-cell.today {
  background: var(--gold-glow);
  border: 1rpx solid var(--border-active);
}

.day-cell.today .day-num {
  color: var(--gold);
  font-weight: 700;
}

/* 选中状态：暖金填充 */
.day-cell.selected {
  background: linear-gradient(135deg, var(--gold) 0%, var(--gold-dark) 100%);
}

.day-cell.selected .day-num {
  color: var(--bg-deep);
  font-weight: 700;
}

/* 日程标记点 */
.day-dot {
  width: 6rpx;
  height: 6rpx;
  background: var(--gold);
  border-radius: 50%;
  margin-top: 6rpx;
  box-shadow: 0 0 6rpx var(--gold-glow);
}

/* === 日程区域 === */
.schedule-section {
  margin-top: 28rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
  letter-spacing: 0.5rpx;
}

.add-btn {
  width: 56rpx;
  height: 56rpx;
  background: linear-gradient(135deg, var(--gold) 0%, var(--gold-dark) 100%);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: var(--shadow);
}

.add-btn:active {
  opacity: 0.85;
  transform: scale(0.95);
}

.add-icon {
  color: var(--bg-deep);
  font-size: 34rpx;
  font-weight: 400;
  line-height: 1;
}

/* === 详情弹窗 === */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.55);
  z-index: 100;
  backdrop-filter: blur(4rpx);
  -webkit-backdrop-filter: blur(4rpx);
}

.detail-modal {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: linear-gradient(180deg, #151830 0%, #111527 100%);
  border: 1rpx solid var(--border);
  border-bottom: none;
  border-radius: var(--radius-xl) var(--radius-xl) 0 0;
  z-index: 101;
  transform: translateY(100%);
  transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  max-height: 82vh;
  overflow-y: auto;
  box-shadow: 0 -8rpx 40rpx rgba(0, 0, 0, 0.6);
}

.detail-modal.show {
  transform: translateY(0);
}

.detail-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx 28rpx;
  border-bottom: 1rpx solid var(--border);
}

.detail-title {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.detail-close {
  font-size: 32rpx;
  color: var(--text-muted);
  padding: 8rpx 12rpx;
  border-radius: var(--radius-sm);
}

.detail-close:active {
  background: var(--bg-surface);
}

.detail-body {
  padding: 24rpx 28rpx;
}

.detail-meta {
  margin-bottom: 24rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  align-items: center;
}

.detail-date {
  font-size: 26rpx;
  color: var(--text-secondary);
}

.detail-category {
  display: inline-block;
  font-size: 23rpx;
  color: var(--gold);
  background: var(--gold-glow);
  border: 1rpx solid var(--border-active);
  padding: 6rpx 18rpx;
  border-radius: 24rpx;
  font-weight: 500;
}

.detail-content {
  font-size: 28rpx;
  color: var(--text-secondary);
  line-height: 1.7;
  margin-bottom: 28rpx;
  padding: 20rpx;
  background: var(--bg-surface);
  border-radius: var(--radius);
  border: 1rpx solid var(--border);
}

/* === AI建议区域 === */
.ai-section {
  margin-top: 24rpx;
}

.ai-header {
  margin-bottom: 16rpx;
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.ai-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--gold);
}

.ai-content {
  font-size: 26rpx;
  line-height: 1.8;
  color: var(--text-secondary);
  background: var(--bg-surface);
  border: 1rpx solid var(--border);
  padding: 24rpx;
  border-radius: var(--radius-lg);
  white-space: pre-wrap;
  letter-spacing: 0.3rpx;
}

.ai-generate-btn {
  background: linear-gradient(135deg, var(--gold) 0%, var(--gold-dark) 100%);
  color: var(--bg-deep);
  text-align: center;
  padding: 26rpx;
  border-radius: var(--radius);
  font-size: 28rpx;
  font-weight: 600;
  letter-spacing: 0.5rpx;
  box-shadow: 0 4rpx 20rpx rgba(200, 169, 110, 0.15);
}

.ai-generate-btn:active {
  opacity: 0.85;
  transform: scale(0.98);
}

/* === 底部操作 === */
.detail-footer {
  display: flex;
  gap: 16rpx;
  padding: 24rpx 28rpx;
  padding-bottom: 48rpx;
  border-top: 1rpx solid var(--border);
}

.btn-edit {
  flex: 1;
  text-align: center;
  color: var(--gold);
  font-size: 28rpx;
  font-weight: 500;
  padding: 18rpx;
  border: 1rpx solid var(--border-active);
  border-radius: var(--radius);
  background: var(--gold-glow);
}

.btn-edit:active {
  background: var(--gold-strong);
}

.btn-del {
  flex: 1;
  text-align: center;
  color: var(--danger);
  font-size: 28rpx;
  font-weight: 500;
  padding: 18rpx;
  border: 1rpx solid rgba(224, 85, 96, 0.2);
  border-radius: var(--radius);
  background: var(--danger-bg);
}

.btn-del:active {
  background: rgba(224, 85, 96, 0.2);
}
