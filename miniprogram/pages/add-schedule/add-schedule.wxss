/* pages/add-schedule/add-schedule.wxss */
/* 暖金深色主题 */

.page-title {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--text-primary);
  padding: 16rpx 0 28rpx;
  letter-spacing: 0.5rpx;
}

.form-group {
  margin-bottom: 28rpx;
}

.form-label {
  font-size: 27rpx;
  font-weight: 500;
  color: var(--text-secondary);
  margin-bottom: 14rpx;
  letter-spacing: 0.3rpx;
}

.required {
  color: var(--danger);
}

.form-input {
  background: var(--bg-surface);
  border: 1rpx solid var(--border);
  border-radius: var(--radius);
  padding: 24rpx 22rpx;
  font-size: 28rpx;
  color: var(--text-primary);
  transition: border-color 0.2s;
}

.form-input:focus {
  border-color: var(--border-active);
  background: var(--bg-surface-hover);
}

.form-input::placeholder {
  color: var(--text-dim);
}

.form-picker {
  background: var(--bg-surface);
  border: 1rpx solid var(--border);
  border-radius: var(--radius);
  padding: 24rpx 22rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 28rpx;
  color: var(--text-primary);
}

.form-picker .placeholder {
  color: var(--text-dim);
}

.picker-arrow {
  font-size: 26rpx;
  opacity: 0.5;
}

.form-textarea {
  background: var(--bg-surface);
  border: 1rpx solid var(--border);
  border-radius: var(--radius);
  padding: 22rpx;
  font-size: 26rpx;
  color: var(--text-primary);
  min-height: 200rpx;
  width: 100%;
  box-sizing: border-box;
  line-height: 1.6;
  transition: border-color 0.2s;
}

.form-textarea:focus {
  border-color: var(--border-active);
  background: var(--bg-surface-hover);
}

.form-textarea::placeholder {
  color: var(--text-dim);
}

.char-count {
  text-align: right;
  font-size: 22rpx;
  color: var(--text-muted);
  margin-top: 8rpx;
}

/* === 智能提示示例 === */
.tips-section {
  margin-bottom: 32rpx;
}

.tips-title {
  font-size: 25rpx;
  font-weight: 500;
  color: var(--gold);
  margin-bottom: 16rpx;
  letter-spacing: 0.5rpx;
}

.tip-item {
  background: var(--bg-surface);
  border: 1rpx solid var(--border);
  color: var(--text-secondary);
  font-size: 24rpx;
  padding: 18rpx 22rpx;
  border-radius: var(--radius);
  margin-bottom: 12rpx;
  line-height: 1.5;
  transition: all 0.15s;
}

.tip-item:active {
  background: var(--bg-surface-hover);
  border-color: var(--border-active);
  color: var(--gold-light);
}

/* === 提交按钮 === */
.submit-section {
  padding-top: 20rpx;
}

.btn-submit {
  background: linear-gradient(135deg, var(--gold) 0%, var(--gold-dark) 100%);
  color: var(--bg-deep);
  text-align: center;
  padding: 28rpx;
  border-radius: var(--radius);
  font-size: 30rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
  margin-bottom: 18rpx;
  box-shadow: 0 4rpx 24rpx rgba(200, 169, 110, 0.15);
  transition: all 0.15s;
}

.btn-submit:active {
  opacity: 0.85;
  transform: scale(0.98);
}

.btn-submit.disabled {
  background: var(--bg-surface);
  color: var(--text-dim);
  box-shadow: none;
}

.btn-save {
  text-align: center;
  color: var(--gold);
  font-size: 28rpx;
  font-weight: 500;
  padding: 20rpx;
  letter-spacing: 0.5rpx;
}

.btn-save:active {
  opacity: 0.7;
}
