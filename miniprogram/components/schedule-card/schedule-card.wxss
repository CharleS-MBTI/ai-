/* components/schedule-card/schedule-card.wxss */
/* 暖金深色主题 */

.schedule-card {
  display: flex;
  align-items: center;
  padding: 24rpx;
  margin: 14rpx 0;
  background: var(--bg-surface);
  border: 1rpx solid var(--border);
  border-radius: var(--radius-lg);
  backdrop-filter: blur(10rpx);
  -webkit-backdrop-filter: blur(10rpx);
  transition: all 0.15s;
  position: relative;
  overflow: hidden;
}

/* 左侧装饰金线 */
.schedule-card::before {
  content: '';
  position: absolute;
  left: 0;
  top: 20%;
  bottom: 20%;
  width: 3rpx;
  background: linear-gradient(180deg, transparent, var(--gold), transparent);
  border-radius: 0 2rpx 2rpx 0;
  opacity: 0.5;
}

.schedule-card:active {
  background: var(--bg-surface-hover);
  border-color: var(--border-active);
}

.card-left {
  min-width: 130rpx;
  text-align: center;
  margin-right: 22rpx;
}

.card-time {
  font-size: 28rpx;
  color: var(--gold);
  font-weight: 600;
  margin-bottom: 10rpx;
  letter-spacing: 0.5rpx;
}

.card-category {
  font-size: 20rpx;
  color: var(--gold);
  padding: 5rpx 14rpx;
  border-radius: 24rpx;
  display: inline-block;
  background: var(--gold-glow);
  border: 1rpx solid var(--border-active);
  font-weight: 500;
}

.card-right {
  flex: 1;
  overflow: hidden;
}

.card-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  margin-bottom: 8rpx;
  letter-spacing: 0.3rpx;
}

.card-content {
  font-size: 24rpx;
  color: var(--text-muted);
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  line-height: 1.5;
}

.card-arrow {
  font-size: 32rpx;
  color: var(--text-dim);
  margin-left: 14rpx;
  font-weight: 300;
}
